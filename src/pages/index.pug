extends ../layouts/default

block variables
    - var title = 'Главная страница'
    -
        var cardsData = [
            {'title': 'Карточка 1', 'text': 'Текст карточки 1', 'imgUrl': '/image/img1.jpg', 'alt': 'Картинка карточки 1'},
            {'title': 'Карточка 2', 'text': 'Текст карточки 2', 'imgUrl': '/image/img2.jpg', 'alt': 'Картинка карточки 2'},
            {'title': 'Карточка 3', 'text': 'Текст карточки 3', 'imgUrl': '/image/img3.jpg', 'alt': 'Картинка карточки 3'}
        ]

block content 
    include ../components/cards-list/cards-list
        block items 
            include ../components/card/card
            each cardData in cardsData
                +card(cardData.title, cardData.text, cardData.imgUrl, cardData.alt)
